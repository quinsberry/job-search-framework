# Copy to .env.local and fill in. Next.js loads it on the server only.
#
# AI CV conversion (Codex / Claude) needs no variables: it uses the CLI logins
# (`codex login`, `claude auth login`) and ignores OpenAI/Anthropic API keys.

# Required for job matching: the decision model (Jev) is called through OpenRouter.
# Create a key at https://openrouter.ai/keys. Never prefix it with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
